# Copy to .env.local. Every key the app reads is listed here; a key absent from
# this file is a key nobody can configure from a fresh clone.

# ---- Platform ---------------------------------------------------------------
# Canonical public origin. Webhook callbacks and absolute links are built from it,
# never from the request host (see docs on the 2026-09-10 organic-sale incident).
APP_BASE_URL=
# Shared secret checked by every /api/cron/* route. Supabase pg_cron sends it.
CRON_SECRET=
# Signs guest keys for the support agent.
AGENT_GUEST_KEY_SECRET=

# ---- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never referenced from a "use client" file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- WayForPay --------------------------------------------------------------
WFP_MERCHANT_ACCOUNT=
# The registered merchant domain (www.centerway.net.ua). Not a thing to rename.
WFP_MERCHANT_DOMAIN=
WFP_SECRET_KEY=

# ---- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Broadcasts (admin → Розсилки). Sender on its OWN verified subdomain, e.g.
# "CenterWay <news@news.centerway.net.ua>", so a campaign complaint cannot hurt
# receipt delivery. Falls back to the transactional sender when unset.
BROADCAST_FROM=
# Optional reply address for broadcasts.
BROADCAST_REPLY_TO=
# Signs unsubscribe links. Unset → derived from SUPABASE_SERVICE_ROLE_KEY; set it
# before ever rotating that key, or every old unsubscribe link stops working.
BROADCAST_LINK_SECRET=
# Signing secret of the Resend webhook pointed at /api/resend/webhook
# (email.delivered/opened/clicked/bounced/complained). Unset → events refused.
RESEND_WEBHOOK_SECRET=
# Lifecycle letters (welcome, «завтра старт», «день 1»). Accounts created before
# this moment are not welcomed retroactively; default 2026-09-29T00:00:00+03:00.
WELCOME_EMAILS_SINCE=
# Public links the letters mention; a letter leaves the line out while unset.
TELEGRAM_CHANNEL_URL=
TELEGRAM_STREAM_CHAT_URL=

# ---- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Used by `npm run tg:webhook:set` only.
TELEGRAM_WEBHOOK_URL=
SUPPORT_CHAT_ID=
# Forum topic (thread) id in the support group for support requests.
SUPPORT_THREAD_ID=
# Thread for user bug reports; falls back to SUPPORT_THREAD_ID when unset.
BUG_REPORTS_THREAD_ID=
# Thread for landing lead-form submissions; falls back to SUPPORT_THREAD_ID.
LEADS_THREAD_ID=
# Shared secret for the SendPulse chatbot webhook (POST /api/sp/webhook).
SP_WEBHOOK_SECRET=

# ---- Analytics reports to Telegram -----------------------------------------
ANALYTICS_BOT_TOKEN=
ANALYTICS_REPORTS_CHAT_ID=
ANALYTICS_REPORTS_THREAD_ID=
ANALYTICS_REPORTS_TIMEZONE=Europe/Kyiv

# ---- Meta: Pixel + Conversions API -----------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_PIXEL=
META_AD_PIXEL_ID=
META_CAPI_TOKEN=
META_ACCESS_TOKEN=
# Set only while validating events in Events Manager; leave empty in production.
META_CAPI_TEST_CODE=
META_GRAPH_API_VERSION=

# ---- Meta Ads sync (admin analytics) ---------------------------------------
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
ENABLE_MANUAL_META_SYNC=
META_SYNC_COOLDOWN_SECONDS=
META_SYNC_DEFAULT_DAYS=

# ---- LMS --------------------------------------------------------------------
# Reminder cadence for /api/cron/lms-reminders. Default (unset or anything other
# than "hourly") = "single-daily-run": one run a day reminds everyone on the
# run's own hour. Set to "hourly" ONLY together with an hourly schedule.
LMS_REMINDER_CADENCE=
# Re-seeds the dosha test questions on next load. Local only.
DOSHA_TEST_FORCE_RESEED=

# ---- Landing cutover --------------------------------------------------------
# Serves the Next-rendered Short/IREM landings instead of the static bundles.
CW_NEXT_LANDING_SHORT_IREM=
