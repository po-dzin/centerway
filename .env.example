# Reminder cadence for /api/cron/lms-reminders. Default (unset or anything other
# than "hourly") = "single-daily-run": one run a day reminds everyone on the
# run's own hour, because a daily job that still waits for each learner's local
# reminder hour reminds nobody. Set to "hourly" ONLY together with an hourly
# schedule — then each learner is nudged at the reminder hour on their own clock.
LMS_REMINDER_CADENCE=
