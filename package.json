{
  "name": "centerway-platform",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 8000",
    "dev:alt": "next dev -p 8021",
    "build": "next build --webpack",
    "start": "next start -p 8000",
    "lint": "eslint src scripts tests next.config.ts eslint.config.mjs vitest.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf .next .next-dev output artifacts test-results playwright-report tsconfig.tsbuildinfo && find . -name .DS_Store -not -path './node_modules/*' -delete",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:guards": "node scripts/verify-guards.mjs",
    "verify:ds": "npm run guard:canon && npm run guard:assets && npm run tokens:check && npm run ds:sync:check && npm run brand:check && npm run guard:ds-contract && npm run guard:contrast && npm run guard:buttons && npm run guard:geometry && npm run ds:drift:gate && npm run generator:validate && npm run guard:semantic && npm run lint && npm run build",
    "verify:lms": "npm run guard:lms-core && npm run lms:validate && npm run lint && npm run build",
    "verify:landing": "node scripts/verify-landing.mjs",
    "verify:admin": "node scripts/verify-admin.mjs",
    "verify:dosha": "npm run smoke:dosha:result && npm run smoke:dosha:api && npm run smoke:dosha:userflows && npm run smoke:dosha:responsive && npm run smoke:dosha:brand-fit",
    "verify:generator": "npm run generator:validate && npm run generator:snapshot && npm run generator:determinism && npm run generator:language && npm run guard:rhythm",
    "docs:index": "node scripts/docs-index.mjs",
    "docs:index:check": "node scripts/docs-index.mjs --check",
    "tokens:build": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs && git diff --exit-code -- src/app/globals.css src/landing-static/shared/css/cw-tokens.generated.css",
    "brand:build": "node scripts/brand-mark-bake.mjs",
    "brand:check": "node scripts/brand-mark-bake.mjs --check",
    "icons:build": "node scripts/icons-bake.mjs",
    "icons:check": "node scripts/icons-bake.mjs --check",
    "icons:preview": "node scripts/icons-preview.mjs",
    "img:generate": "node scripts/img/generate.mjs",
    "img:grade": "node scripts/img/grade.mjs",
    "img:webp": "node scripts/img/webp.mjs",
    "img:landing-webp": "node scripts/img/landing-webp.mjs",
    "img:face-mosaic": "node scripts/img/face-mosaic.mjs",
    "guard:canon": "node scripts/guard-platform-canon.mjs",
    "guard:ds-contract": "node scripts/guard-ds-contract.mjs",
    "guard:semantic": "node scripts/semantic-audit.mjs",
    "guard:contrast": "node scripts/guard-contrast.mjs",
    "guard:carriers": "node scripts/guard-carriers.mjs",
    "guard:assets": "node scripts/guard-assets.mjs",
    "guard:buttons": "node scripts/guard-buttons.mjs",
    "guard:geometry": "node scripts/guard-geometry.mjs",
    "guard:bands": "node scripts/guard-bands.mjs",
    "ds:export": "node scripts/ds-export.mjs",
    "ds:sync:check": "node scripts/ds-export.mjs --check",
    "guard:lms-core": "eslint src/lms-core",
    "guard:eslint": "node scripts/guard-eslint-rules.mjs",
    "db:local:up": "supabase start",
    "db:local:down": "supabase stop",
    "db:local:sync": "node scripts/db-local.mjs sync",
    "db:local:reset": "node scripts/db-local.mjs reset",
    "db:local:env": "node scripts/db-local.mjs env",
    "db:local:env:off": "node scripts/db-local.mjs env --off",
    "db:local:status": "node scripts/db-local.mjs status",
    "db:rehearse": "npm run db:local:reset && npm run lms:validate && npm run build",
    "db:push:dry": "node scripts/db-push.mjs --dry-run",
    "db:push": "node scripts/db-push.mjs",
    "lms:validate": "vitest run src/lms-core src/lib/lms",
    "lms:seed": "npm run lms:validate && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/lms-seed.mjs",
    "lms:seed:dry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/lms-seed.mjs --dry-run",
    "lms:import": "npm run lms:validate && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/lms-import.mjs",
    "lms:pull": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/lms-pull.mjs",
    "lms:snapshot:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/lms-snapshot-check.mjs",
    "lms:grant": "node scripts/lms-grant.mjs",
    "wfp:reconcile": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/wfp-reconcile.mjs",
    "wfp:refund": "node scripts/wfp-refund.mjs",
    "media:sweep": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/media-sweep.mjs",
    "media:sweep:apply": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/media-sweep.mjs --apply",
    "admin:role": "node scripts/admin-role.mjs",
    "admin:offer": "node scripts/course-offer.mjs",
    "shelf:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/shelf-check.mjs",
    "agent:eval": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/agent-eval.mjs",
    "generator:validate": "node scripts/generator-validate.mjs",
    "guard:rhythm": "node scripts/guard-rhythm-grid.mjs",
    "generator:snapshot": "node scripts/generator-build-snapshots.mjs",
    "generator:determinism": "node scripts/generator-determinism.mjs",
    "generator:language": "node scripts/generator-language-guard.mjs",
    "smoke:admin": "node scripts/smoke-admin-api.mjs",
    "smoke:admin:auth": "node scripts/smoke-admin-api.mjs --require-auth",
    "smoke:admin:authz-surface": "node scripts/smoke-admin-authz-surface.mjs",
    "smoke:admin:funnel": "node scripts/smoke-admin-funnel-consistency.mjs",
    "smoke:admin:landing-offers": "node scripts/smoke-admin-landing-offers.mjs",
    "smoke:admin:payload-contracts": "node scripts/smoke-admin-payload-contracts.mjs",
    "smoke:admin:write-guards": "node scripts/smoke-admin-write-guards.mjs",
    "guard:admin:authz-coverage": "node scripts/guard-admin-authz-coverage.mjs",
    "guard:admin:governance": "node scripts/guard-admin-governance.mjs",
    "guard:admin:i18n-tone": "node scripts/guard-admin-i18n-tone.mjs",
    "guard:admin:a11y-contract": "node scripts/guard-admin-a11y-contract.mjs",
    "smoke:admin:responsive": "node scripts/smoke-admin-responsive.mjs",
    "smoke:admin:ui": "node scripts/smoke-admin-ui.mjs",
    "smoke:landing:dynamic-offer": "node scripts/smoke-landing-dynamic-offer.mjs",
    "smoke:platform:browser": "npx playwright test tests/e2e/platform-unification.spec.ts --reporter=list",
    "smoke:thanks:browser": "npx playwright test tests/e2e/thanks-redirect-order.spec.ts --reporter=list",
    "smoke:dosha:result": "vitest run src/lib/dosha",
    "smoke:dosha:api": "node scripts/smoke-dosha-api-flow.mjs",
    "smoke:dosha:userflows": "node scripts/smoke-dosha-userflows.mjs",
    "smoke:dosha:responsive": "node scripts/smoke-dosha-responsive.mjs",
    "smoke:dosha:brand-fit": "node scripts/smoke-dosha-brand-fit.mjs",
    "smoke:landing:short-irem": "node scripts/smoke-landing-short-irem.mjs",
    "smoke:landing:next-contract": "node scripts/smoke-landing-next-contract.mjs",
    "smoke:landing:cutover-toggle": "node scripts/smoke-landing-cutover-toggle.mjs",
    "smoke:landing:baseline": "node scripts/smoke-landing-baseline.mjs",
    "tg:webhook:set": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/set-telegram-webhook.mjs",
    "tg:doctor": "node scripts/tg-doctor.mjs",
    "tg:profile": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/tg-bot-profile.mjs",
    "ds:drift": "node scripts/design/ds-drift.mjs",
    "ds:drift:report": "node scripts/design/ds-drift.mjs --write",
    "ds:drift:gate": "node scripts/design/ds-drift.mjs --gate",
    "db:types": "node scripts/db-types.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "docx": "^9.7.1",
    "mammoth": "^1.12.1",
    "next": "16.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
